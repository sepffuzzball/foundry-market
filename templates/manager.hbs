<section class="market-app market-manager" aria-label="Market manager">
  <header class="market-topbar">
    <div class="market-brand"><span class="market-sigil" aria-hidden="true">M</span><div><p class="market-eyebrow">The market ledger</p><h1>Foundry Market</h1></div></div>
    <span class="market-role">GM workspace</span>
  </header>
  <div class="manager-layout">
    <aside class="manager-rail" aria-label="Market locations and shops">
      <div class="rail-heading"><div><p class="market-eyebrow">Your world</p><h2>Locations</h2></div><button class="market-icon-button" type="button" data-action="create-location" aria-label="Create location">+</button></div>
      {{#if locations.length}}
      <nav class="location-list" aria-label="Locations">
        {{#each locations as |location|}}
        <button type="button" class="location-button {{#if (eq ../selectedLocationId location.id)}}is-selected{{/if}}" data-action="select-location" data-location-id="{{location.id}}" aria-current="{{#if (eq ../selectedLocationId location.id)}}true{{else}}false{{/if}}">
          <span class="location-mark" aria-hidden="true">⌂</span><span>{{location.name}}</span>
        </button>
        {{/each}}
      </nav>
      {{else}}
      <p class="market-muted rail-empty">No locations yet. Create one to begin.</p>
      {{/if}}
      <div class="rail-divider"></div>
      <div class="rail-heading shop-heading"><div><p class="market-eyebrow">Selected location</p><h2>Shops</h2></div><button class="market-icon-button" type="button" data-action="create-shop" aria-label="Create shop">+</button></div>
      {{#if shops.length}}
      <nav class="shop-list" aria-label="Shops">
        {{#each shops as |shop|}}
        <button type="button" class="shop-button {{#if (eq ../selectedShop.id shop.id)}}is-selected{{/if}}" data-action="select-shop" data-shop-id="{{shop.id}}" aria-current="{{#if (eq ../selectedShop.id shop.id)}}true{{else}}false{{/if}}">
          <span class="shop-dot {{#if shop.open}}is-open{{/if}}" aria-hidden="true"></span><span class="shop-button-copy"><strong>{{shop.name}}</strong><small>{{shop.inventoryCount}} {{#if (eq shop.inventoryCount 1)}}item{{else}}items{{/if}}</small></span><span class="shop-chevron" aria-hidden="true">›</span>
        </button>
        {{/each}}
      </nav>
      {{else}}
      <p class="market-muted rail-empty">No shops in this location.</p>
      {{/if}}
    </aside>

    <main class="manager-main">
      {{#if selectedShop}}
      <div class="manager-title-row"><div><p class="market-eyebrow">Shop settings / inventory</p><h2>{{selectedShop.name}}</h2></div><span class="market-state {{#if selectedShop.open}}state-open{{else}}state-closed{{/if}}"><i aria-hidden="true"></i>{{#if selectedShop.open}}Open to players{{else}}Closed{{/if}}</span></div>
      <section class="editor-panel" aria-labelledby="details-heading">
        <div class="section-heading"><div><span class="section-number">01</span><div><p class="market-eyebrow">Identity</p><h3 id="details-heading">Shop details</h3></div></div><button type="button" class="market-button market-button-quiet" data-action="save-shop">Save changes</button></div>
        <div class="editor-fields">
          <label class="market-field field-wide"><span>Shop name</span><input type="text" name="name" value="{{editingShop.name}}" autocomplete="off"></label>
          <label class="market-field"><span>Shopkeeper</span><input type="text" name="owner" value="{{editingShop.owner}}" autocomplete="off"></label>
          <label class="market-field field-wide"><span>Description</span><textarea name="description" rows="3">{{editingShop.description}}</textarea></label>
          <label class="market-check"><input type="checkbox" name="open" {{#if editingShop.open}}checked{{/if}}><span class="check-art" aria-hidden="true"></span><span><strong>Shop is open</strong><small>Players can view this storefront.</small></span></label>
          <input type="hidden" name="locationId" value="{{selectedLocationId}}">
        </div>
      </section>
      <section class="editor-panel appearance-panel" aria-labelledby="appearance-heading">
        <div class="section-heading"><div><span class="section-number">02</span><div><p class="market-eyebrow">Storefront styling</p><h3 id="appearance-heading">Appearance</h3></div></div><button type="button" class="market-button market-button-outline" data-action="preview-appearance">Preview appearance</button></div>
        <div class="editor-fields">
          <label class="market-field"><span>Theme preset</span><select name="theme">{{#each themeOptions as |option|}}<option value="{{option.id}}" {{#if (eq ../editingShop.theme option.id)}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label>
          <label class="market-field"><span>Owner portrait</span><span class="media-field"><input type="text" name="ownerPortrait" value="{{editingShop.appearance.ownerPortrait}}"><button type="button" class="market-button market-button-quiet" data-action="browse-media" data-media-target="ownerPortrait">Browse</button></span></label>
          <label class="market-field"><span>Background image</span><span class="media-field"><input type="text" name="backgroundImage" value="{{editingShop.appearance.backgroundImage}}"><button type="button" class="market-button market-button-quiet" data-action="browse-media" data-media-target="backgroundImage">Browse</button></span></label>
          <label class="market-field"><span>Accent color</span><input type="text" name="accentColor" value="{{editingShop.appearance.accentColor}}" placeholder="#c99a4e"></label>
          <label class="market-field"><span>Typography</span><select name="typography"><option value="classic" {{#if (eq editingShop.appearance.typography "classic")}}selected{{/if}}>Classic</option><option value="display" {{#if (eq editingShop.appearance.typography "display")}}selected{{/if}}>Display</option><option value="modern" {{#if (eq editingShop.appearance.typography "modern")}}selected{{/if}}>Modern</option></select></label>
          <label class="market-field"><span>Density</span><select name="density"><option value="comfortable" {{#if (eq editingShop.appearance.density "comfortable")}}selected{{/if}}>Comfortable</option><option value="compact" {{#if (eq editingShop.appearance.density "compact")}}selected{{/if}}>Compact</option></select></label>
          <label class="market-field"><span>Animation</span><select name="animation"><option value="full" {{#if (eq editingShop.appearance.animation "full")}}selected{{/if}}>Full</option><option value="subtle" {{#if (eq editingShop.appearance.animation "subtle")}}selected{{/if}}>Subtle</option><option value="off" {{#if (eq editingShop.appearance.animation "off")}}selected{{/if}}>Off</option></select></label>
          <label class="market-field"><span>Music</span><span class="media-field"><input type="text" name="music" value="{{editingShop.appearance.music}}"><button type="button" class="market-button market-button-quiet" data-action="browse-media" data-media-target="music">Browse</button></span></label>
          <label class="market-field"><span>Sound effect</span><span class="media-field"><input type="text" name="soundEffect" value="{{editingShop.appearance.soundEffect}}"><button type="button" class="market-button market-button-quiet" data-action="browse-media" data-media-target="soundEffect">Browse</button></span></label>
          <label class="market-field field-wide"><span>Welcome message</span><textarea name="welcomeMessage" rows="2">{{editingShop.appearance.welcomeMessage}}</textarea></label>
        </div>
         {{#if previewShop}}<div class="appearance-preview"><div class="preview-heading"><p class="market-eyebrow">Live preview · {{themeMeta.label}}</p><button type="button" class="market-button market-button-quiet" data-action="reset-preview">Reset preview</button></div><div class="preview-panel theme-{{previewShop.theme}} density-{{previewShop.appearance.density}} type-{{previewShop.appearance.typography}} motion-{{previewShop.appearance.animation}}"><div class="preview-shop-identity"><span class="preview-glyph" aria-hidden="true">{{themeMeta.glyph}}</span>{{#if previewShop.appearance.ownerPortrait}}<img class="preview-portrait" src="{{previewShop.appearance.ownerPortrait}}" alt="{{previewShop.owner}}">{{else}}<span class="preview-portrait preview-portrait-fallback" aria-hidden="true">{{themeMeta.glyph}}</span>{{/if}}<div><h4>{{previewShop.name}}</h4><p class="preview-owner">Kept by {{previewShop.owner}}</p></div></div><p class="preview-welcome">{{previewShop.appearance.welcomeMessage}}</p><p class="preview-blurb">{{themeMeta.blurb}}</p><div class="preview-product-card"><span class="preview-product-art" aria-hidden="true">{{themeMeta.glyph}}</span><span class="preview-product-copy"><strong>A sample from the shelves</strong><small>Fine wares · 12 {{currencyLabel}}</small></span><span class="preview-product-mark" aria-hidden="true">✦</span></div></div></div>{{/if}}
      </section>
      <section class="editor-panel social-panel" aria-labelledby="social-heading">
        <div class="section-heading"><div><span class="section-number">03</span><div><p class="market-eyebrow">A living reputation</p><h3 id="social-heading">Social economy</h3></div></div><button type="button" class="market-button market-button-quiet" data-action="save-social">Save social settings</button></div>
        <div class="editor-fields social-settings">
          <label class="market-field"><span>Primary personality</span><select name="primaryPersonality">{{#each personalityOptions as |option|}}<option value="{{option.id}}" {{#if (eq ../editingShop.social.primaryPersonality option.id)}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label>
          <label class="market-field"><span>Secondary personality</span><select name="secondaryPersonality"><option value="">None</option>{{#each personalityOptions as |option|}}<option value="{{option.id}}" {{#if (eq ../editingShop.social.secondaryPersonality option.id)}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label>
          <label class="market-field"><span>Secondary influence</span><input type="number" name="secondaryWeight" value="{{editingShop.social.secondaryWeight}}" min="0" max="100"></label>
          <label class="market-field"><span>Individual influence</span><input type="number" name="individualWeight" value="{{editingShop.social.individualWeight}}" min="0" max="100"></label>
          <label class="market-field"><span>Party influence</span><input type="number" name="partyWeight" value="{{editingShop.social.partyWeight}}" min="0" max="100"></label>
          <label class="market-field"><span>Party ID</span><input type="text" name="partyId" value="{{editingShop.social.partyId}}"></label>
          <label class="market-field"><span>Shop markup (basis points)</span><input type="number" name="shopMarkupBps" value="{{editingShop.social.shopMarkupBps}}" min="-9000" max="50000" step="1"></label>
        </div>
        <div class="social-subsection"><div class="social-subheading"><div><p class="market-eyebrow">Up to three shopkeepers</p><h4>Merchant roster</h4></div><button class="market-button market-button-outline" type="button" data-action="add-npc">Add merchant</button></div>
          {{#if selectedShop.npcs.length}}<div class="npc-list">{{#each selectedShop.npcs as |npc|}}<fieldset class="npc-editor" data-npc-id="{{npc.id}}"><legend>{{#if npc.name}}{{npc.name}}{{else}}New merchant{{/if}}</legend><div class="editor-fields"><label class="market-field"><span>Name</span><input name="npcName" value="{{npc.name}}"></label><label class="market-field"><span>Role</span><input name="npcRole" value="{{npc.role}}"></label><label class="market-field"><span>Actor UUID</span><input name="npcActorUuid" value="{{npc.actorUuid}}"></label><label class="market-field"><span>Portrait</span><input name="npcPortrait" value="{{npc.portrait}}"></label><label class="market-field"><span>Personality</span><select name="npcPersonality">{{#each ../../personalityOptions as |option|}}<option value="{{option.id}}" {{#if (eq npc.personality option.id)}}selected{{/if}}>{{option.label}}</option>{{/each}}</select></label><label class="market-field"><span>Greeting</span><textarea name="npcGreeting" rows="2">{{npc.greeting}}</textarea></label><label class="market-check"><input type="checkbox" name="npcVisible" {{#if npc.visible}}checked{{/if}}><span class="check-art" aria-hidden="true"></span><span><strong>Visible to players</strong></span></label></div><div class="npc-actions"><button type="button" class="market-button market-button-quiet" data-action="save-npcs">Save merchants</button><button type="button" class="market-button market-button-quiet" data-action="remove-npc" data-npc-id="{{npc.id}}">Remove merchant</button></div></fieldset>{{/each}}</div>{{else}}<p class="market-muted">No merchants added. The shop can still use its owner portrait.</p>{{/if}}
        </div>
        <div class="social-subsection reputation-editor"><div class="social-subheading"><div><p class="market-eyebrow">Standing across the market</p><h4>Reputation</h4></div></div>
          {{#if reputationActors.length}}<label class="market-field reputation-select"><span>Character</span><select name="reputationActorId"><option value="">Choose a character</option>{{#each reputationActors as |actor|}}<option value="{{actor.id}}" {{#if (eq ../selectedReputationActorId actor.id)}}selected{{/if}}>{{actor.name}}</option>{{/each}}</select></label>{{else}}<p class="market-muted">No characters are available for reputation adjustments.</p>{{/if}}
          {{#if selectedReputation}}<div class="reputation-summary"><strong>{{selectedReputation.title}}</strong><span>Score {{selectedReputation.score}}</span><span>Individual {{selectedReputation.individual}}</span><span>Party {{selectedReputation.party}}</span></div>{{#if reputationHistory.length}}<ol class="reputation-history">{{#each reputationHistory as |record|}}<li><span>{{record.reason}}</span><strong>{{record.delta}}</strong><time>{{record.createdAt}}</time></li>{{/each}}</ol>{{else}}<p class="market-muted">No reputation history yet.</p>{{/if}}<div class="reputation-adjust"><label class="market-field"><span>Adjustment</span><input type="number" name="reputationDelta" step="1" placeholder="+5 or -5"></label><label class="market-field"><span>Reason</span><input type="text" name="reputationReason"></label><button type="button" class="market-button market-button-dark" data-action="adjust-reputation">Adjust reputation</button></div>{{else}}<p class="market-muted">Select a character with a reputation record to review or adjust standing.</p>{{/if}}
        </div>
        <div class="social-subsection valuation-panel"><div class="social-subheading"><div><p class="market-eyebrow">GM-approved buyback prices</p><h4>Item valuations</h4></div><button type="button" class="market-button market-button-dark" data-action="approve-valuation" {{#unless isActiveGM}}disabled{{/unless}}>Approve valuation</button></div><p class="market-muted">Reuse the Character selector above to choose whose items to value. Only an item with a GM-approved valuation can be sold or bartered by that character.</p>{{#if valuationActorName}}<p class="market-muted">Valuing items for <strong>{{valuationActorName}}</strong>.</p>{{/if}}{{#if valuationItems.length}}<label class="market-field"><span>Item</span><select name="valuationItemId"><option value="">Choose an item</option>{{#each valuationItems as |item|}}<option value="{{item.id}}">{{item.name}}</option>{{/each}}</select></label><label class="market-field"><span>Approved amount ({{currencyLabel}})</span><input type="number" name="valuationAmount" min="1" step="1"></label>{{else}}<p class="market-muted">No items on this character to value.</p>{{/if}}{{#if approvedValuations.length}}<ul class="valuation-list">{{#each approvedValuations as |v|}}<li><span>{{v.itemId}} · {{v.actorUuid}}</span><strong>{{v.amount}} {{../currencyLabel}}</strong></li>{{/each}}</ul>{{else}}<p class="market-muted">No valuations approved for this shop yet.</p>{{/if}}</div>
      </section>
      <section class="editor-panel automation-panel" aria-labelledby="automation-heading">
        <div class="section-heading"><div><span class="section-number">04</span><div><p class="market-eyebrow">Shop schedule</p><h3 id="automation-heading">Hours &amp; arrivals</h3></div></div></div>
        <div class="automation-grid">
          <form class="automation-card automation-hours">
            <div class="social-subheading"><div><p class="market-eyebrow">Opening hours</p><h4>Weekly schedule</h4></div><button type="button" class="market-button market-button-quiet" data-action="save-hours">Save hours</button></div>
            <label class="market-check"><input type="checkbox" name="hoursEnabled" {{#if selectedShop.automation.hours.enabled}}checked{{/if}}><span class="check-art" aria-hidden="true"></span><span><strong>Use scheduled hours</strong></span></label>
            <fieldset class="weekday-picker"><legend>Open days</legend>{{#each weekdays as |day|}}<label class="weekday-option"><input type="checkbox" name="hoursDay" value="{{day.id}}" {{#if day.selected}}checked{{/if}}><span>{{day.label}}</span></label>{{/each}}</fieldset>
            <div class="automation-fields"><label class="market-field"><span>Opens (minute of day)</span><input type="number" name="openMinute" min="0" max="1439" value="{{selectedShop.automation.hours.openMinute}}"></label><label class="market-field"><span>Closes (minute of day)</span><input type="number" name="closeMinute" min="0" max="1439" value="{{selectedShop.automation.hours.closeMinute}}"></label></div>
          </form>
          <form class="automation-card automation-travel">
            <div class="social-subheading"><div><p class="market-eyebrow">Moving shop</p><h4>Travel schedule</h4></div><button type="button" class="market-button market-button-quiet" data-action="save-travel">Save travel</button></div>
            <label class="market-check"><input type="checkbox" name="travelEnabled" {{#if selectedShop.automation.travel.enabled}}checked{{/if}}><span class="check-art" aria-hidden="true"></span><span><strong>Enable travel</strong></span></label>
            <fieldset class="weekday-picker"><legend>Travel destinations</legend>{{#each travelLocationOptions as |location|}}<label class="weekday-option"><input type="checkbox" name="travelLocationId" value="{{location.id}}" {{#if location.selected}}checked{{/if}}><span>{{location.name}}</span></label>{{/each}}</fieldset>
            <div class="automation-fields"><label class="market-field"><span>Anchor time</span><input type="number" name="travelAnchorTime" value="{{selectedShop.automation.travel.anchorTime}}"></label><label class="market-field"><span>Interval (seconds)</span><input type="number" name="travelIntervalSeconds" min="3600" value="{{selectedShop.automation.travel.intervalSeconds}}"></label></div>
          </form>
        </div>
      </section>
      <section class="editor-panel automation-panel" aria-labelledby="events-heading">
        <div class="section-heading"><div><span class="section-number">05</span><div><p class="market-eyebrow">Public notices</p><h3 id="events-heading">Market events</h3></div></div><button type="button" class="market-button market-button-outline" data-action="add-event">Add event</button></div>
        {{#if eventRows.length}}<div class="event-editor-list">{{#each eventRows as |event|}}<fieldset class="event-editor" data-event-id="{{event.id}}"><legend>{{#if event.title}}{{event.title}}{{else}}New event{{/if}}</legend><div class="editor-fields"><label class="market-field"><span>Title</span><input type="text" name="eventTitle" value="{{event.title}}"></label><label class="market-field"><span>Description</span><textarea name="eventDescription" rows="2">{{event.description}}</textarea></label><label class="market-field"><span>Starts (world seconds)</span><input type="number" name="eventStartAt" value="{{event.startAt}}" step="1"></label><label class="market-field"><span>Ends (world seconds)</span><input type="number" name="eventEndAt" value="{{event.endAt}}" step="1"></label><label class="market-check"><input type="checkbox" name="eventVisible" {{#if event.visible}}checked{{/if}}><span class="check-art" aria-hidden="true"></span><span><strong>Visible to players</strong></span></label></div><div class="npc-actions"><button type="button" class="market-button market-button-quiet" data-action="remove-event" data-event-id="{{event.id}}">Remove event</button></div></fieldset>{{/each}}</div>{{else}}<p class="market-muted">No events scheduled. Add an event to announce it on the storefront.</p>{{/if}}
        <div class="manager-footer-actions"><button type="button" class="market-button market-button-quiet" data-action="save-events">Save events</button></div>
      </section>
      <section class="editor-panel automation-panel" aria-labelledby="diagnostics-heading">
        <div class="section-heading"><div><span class="section-number">06</span><div><p class="market-eyebrow">Scheduled activity</p><h3 id="diagnostics-heading">Automation</h3></div></div><button type="button" class="market-button market-button-dark" data-action="run-automation" {{#unless isActiveGM}}disabled{{/unless}}>Run now</button></div>
        <p class="market-muted">Automation controls and diagnostics are available to the active GM only.</p>
        {{#if automationDiagnostics}}<dl class="diagnostics-list"><div><dt>Last run</dt><dd>{{automationDiagnostics.lastRunAt}}</dd></div><div><dt>Status</dt><dd>{{automationDiagnostics.lastStatus}}</dd></div><div><dt>Last restocked</dt><dd>{{automationDiagnostics.lastRestocked}}</dd></div><div><dt>Last destination</dt><dd>{{automationDiagnostics.lastLocationId}}</dd></div>{{#if automationDiagnostics.lastError}}<div class="diagnostic-error"><dt>Last error</dt><dd>{{automationDiagnostics.lastError}}</dd></div>{{/if}}</dl>{{/if}}
      </section>
      <section class="editor-panel commerce-panel" aria-labelledby="commerce-heading">
        <div class="section-heading"><div><span class="section-number">07</span><div><p class="market-eyebrow">Trade policy</p><h3 id="commerce-heading">Commerce controls</h3></div></div><button type="button" class="market-button market-button-dark" data-action="save-commerce" {{#unless isActiveGM}}disabled{{/unless}}>Save commerce</button></div>
        <div class="editor-fields"><label class="market-field"><span>Merchant funds</span><input type="number" name="merchantFunds" min="0" value="{{selectedShop.commerce.funds}}" aria-describedby="funds-note" {{#unless isActiveGM}}disabled{{/unless}}></label><label class="market-check"><input type="checkbox" name="unlimitedFunds" {{#if (eq selectedShop.commerce.funds null)}}checked{{/if}} {{#unless isActiveGM}}disabled{{/unless}}><span class="check-art" aria-hidden="true"></span><span><strong>Unlimited funds</strong><small id="funds-note">Allow merchant purchases without a fund limit.</small></span></label><label class="market-field"><span>Buy rate (basis points)</span><input type="number" name="buyRateBps" min="0" value="{{selectedShop.commerce.buyRateBps}}" {{#unless isActiveGM}}disabled{{/unless}}></label><label class="market-field"><span>Buyback rate (basis points)</span><input type="number" name="buybackRateBps" min="0" value="{{selectedShop.commerce.buybackRateBps}}" {{#unless isActiveGM}}disabled{{/unless}}></label><label class="market-check"><input type="checkbox" name="preordersEnabled" {{#if selectedShop.commerce.preorders.enabled}}checked{{/if}} {{#unless isActiveGM}}disabled{{/unless}}><span class="check-art" aria-hidden="true"></span><span><strong>Accept preorders</strong></span></label><label class="market-field"><span>Preorder deposit (basis points)</span><input type="number" name="depositBps" min="0" max="10000" value="{{selectedShop.commerce.preorders.depositBps}}" {{#unless isActiveGM}}disabled{{/unless}}></label><label class="market-field"><span>Maximum per character</span><input type="number" name="maxPerActor" min="0" value="{{selectedShop.commerce.preorders.maxPerActor}}" {{#unless isActiveGM}}disabled{{/unless}}></label><label class="market-check"><input type="checkbox" name="theftEnabled" {{#if selectedShop.commerce.theft.enabled}}checked{{/if}} {{#unless isActiveGM}}disabled{{/unless}}><span class="check-art" aria-hidden="true"></span><span><strong>Allow theft attempts</strong></span></label></div>
        <div class="commerce-subsection"><div class="social-subheading"><div><p class="market-eyebrow">Optional offerings</p><h4>Services</h4></div><button type="button" class="market-button market-button-outline" data-action="add-service" {{#unless isActiveGM}}disabled{{/unless}}>Add service</button></div>{{#each serviceRows as |service|}}<fieldset class="commerce-row" data-service-id="{{service.id}}"><legend>{{service.name}}</legend><div class="editor-fields"><label class="market-field"><span>Name</span><input name="serviceName" value="{{service.name}}" {{#unless ../isActiveGM}}disabled{{/unless}}></label><label class="market-field"><span>Price</span><input type="number" name="servicePrice" min="0" value="{{service.price}}" {{#unless ../isActiveGM}}disabled{{/unless}}></label><label class="market-field field-wide"><span>Description</span><textarea name="serviceDescription" rows="2" {{#unless ../isActiveGM}}disabled{{/unless}}>{{service.description}}</textarea></label><label class="market-check"><input type="checkbox" name="serviceVisible" {{#if service.visible}}checked{{/if}} {{#unless ../isActiveGM}}disabled{{/unless}}><span class="check-art" aria-hidden="true"></span><span><strong>Visible</strong></span></label><label class="market-check"><input type="checkbox" name="serviceEnabled" {{#if service.enabled}}checked{{/if}} {{#unless ../isActiveGM}}disabled{{/unless}}><span class="check-art" aria-hidden="true"></span><span><strong>Enabled</strong></span></label></div><div class="npc-actions"><button type="button" class="market-button market-button-quiet" data-action="save-services" {{#unless ../isActiveGM}}disabled{{/unless}}>Save services</button><button type="button" class="market-button market-button-quiet" data-action="remove-service" data-service-id="{{service.id}}" {{#unless ../isActiveGM}}disabled{{/unless}}>Remove</button></div></fieldset>{{else}}<p class="market-muted">No services listed.</p>{{/each}}
        <div class="commerce-subsection"><div class="social-subheading"><div><p class="market-eyebrow">Limited offers</p><h4>Specials</h4></div><button type="button" class="market-button market-button-outline" data-action="add-special" {{#unless isActiveGM}}disabled{{/unless}}>Add special</button></div>{{#each specialRows as |special|}}<fieldset class="commerce-row" data-special-id="{{special.id}}"><legend>{{special.title}}</legend><div class="editor-fields"><label class="market-field"><span>Title</span><input name="specialTitle" value="{{special.title}}" {{#unless ../isActiveGM}}disabled{{/unless}}></label><label class="market-field"><span>Price</span><input type="number" name="specialPrice" min="0" value="{{special.price}}" {{#unless ../isActiveGM}}disabled{{/unless}}></label><label class="market-field"><span>Description</span><textarea name="specialDescription" rows="2" {{#unless ../isActiveGM}}disabled{{/unless}}>{{special.description}}</textarea></label><label class="market-field"><span>Inventory item</span><select name="specialEntryId" {{#unless ../isActiveGM}}disabled{{/unless}}>{{#each ../selectedShop.inventory as |entry|}}<option value="{{entry.id}}" {{#if (eq special.entryId entry.id)}}selected{{/if}}>{{entry.name}}</option>{{/each}}</select></label><label class="market-field"><span>Character UUIDs (comma-separated)</span><input name="specialActorUuids" value="{{special.actorUuidsText}}" {{#unless ../isActiveGM}}disabled{{/unless}}></label><label class="market-check"><input type="checkbox" name="specialVisible" {{#if special.visible}}checked{{/if}} {{#unless ../isActiveGM}}disabled{{/unless}}><span class="check-art" aria-hidden="true"></span><span><strong>Visible</strong></span></label></div><div class="npc-actions"><button type="button" class="market-button market-button-quiet" data-action="save-specials" {{#unless ../isActiveGM}}disabled{{/unless}}>Save specials</button><button type="button" class="market-button market-button-quiet" data-action="remove-special" data-special-id="{{special.id}}" {{#unless ../isActiveGM}}disabled{{/unless}}>Remove</button></div></fieldset>{{else}}<p class="market-muted">No specials listed.</p>{{/each}}</div>
      </section>
      {{#if advancedOrders.length}}<section class="editor-panel commerce-panel" aria-labelledby="orders-heading"><div class="section-heading"><div><span class="section-number">08</span><div><p class="market-eyebrow">Manual review</p><h3 id="orders-heading">Advanced orders</h3></div></div></div><p class="commerce-warning">Services, preorders, and theft require manual adjudication by a GM. No automatic service effect or player theft success is applied.</p><div class="order-list">{{#each advancedOrders as |order|}}<article class="order-card"><div><strong>{{order.kind}} · {{order.status}}</strong><p>Character {{order.actorId}} · Item {{order.entryId}}</p><small>Total {{order.total}} · Deposit {{order.deposit}} · Remaining {{order.remaining}} · {{order.createdAt}}</small></div><div class="npc-actions">{{#if (eq order.kind "service")}}{{#if (eq order.status "booked")}}<button type="button" class="market-button market-button-dark" data-action="fulfill-service" data-order-id="{{order.id}}" {{#unless ../isActiveGM}}disabled{{/unless}}>Mark fulfilled</button>{{/if}}{{else if (eq order.kind "preorder")}}{{#if (eq order.status "booked")}}<button type="button" class="market-button market-button-dark" data-action="fulfill-preorder" data-order-id="{{order.id}}" {{#unless ../isActiveGM}}disabled{{/unless}}>Fulfill</button><button type="button" class="market-button market-button-quiet" data-action="cancel-preorder" data-order-id="{{order.id}}" {{#unless ../isActiveGM}}disabled{{/unless}}>Cancel</button>{{/if}}{{else if (eq order.kind "theft")}}{{#if (eq order.status "booked")}}<button type="button" class="market-button market-button-dark" data-action="resolve-theft-success" data-order-id="{{order.id}}" {{#unless ../isActiveGM}}disabled{{/unless}}>Resolve success</button><button type="button" class="market-button market-button-quiet" data-action="resolve-theft-failure" data-order-id="{{order.id}}" {{#unless ../isActiveGM}}disabled{{/unless}}>Resolve failure</button>{{/if}}{{/if}}</div></article>{{/each}}</div><div class="order-paging">{{#if hasPreviousOrders}}<button type="button" class="market-button market-button-quiet" data-action="prev-orders">Previous</button>{{/if}}{{#if hasNextOrders}}<button type="button" class="market-button market-button-quiet" data-action="next-orders">Next</button>{{/if}}</div></section>{{/if}}
<section class="inventory-panel" data-drop-zone aria-labelledby="inventory-heading">
        <div class="section-heading"><div><span class="section-number">03</span><div><p class="market-eyebrow">What is on the shelves</p><h3 id="inventory-heading">Inventory <span class="count-pill">{{selectedShop.inventory.length}}</span></h3></div></div><button type="button" class="market-button market-button-dark" data-action="add-item-picker"><span aria-hidden="true">+</span> Add item</button></div>
        {{#if selectedShop.inventory.length}}
        <div class="inventory-table-wrap"><table class="inventory-table"><thead><tr><th scope="col">Item</th><th scope="col">Price</th><th scope="col">Quantity</th><th scope="col">Stock</th><th scope="col"><span class="visually-hidden">Visible</span></th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead><tbody>
          {{#each selectedShop.inventory as |entry|}}
          <tr data-entry-id="{{entry.id}}"><td><div class="inventory-item"><span class="item-thumb">{{#if entry.img}}<img src="{{entry.img}}" alt="">{{else}}<span aria-hidden="true">✦</span>{{/if}}</span><strong>{{entry.name}}</strong></div><label class="row-field">Public description<textarea name="publicDescription" rows="2" aria-label="Public description for {{entry.name}}">{{entry.publicDescription}}</textarea></label></td><td class="price-cell"><input type="number" name="price" value="{{entry.price}}" min="0" step="1" aria-label="Price for {{entry.name}}"><small>{{../currencyLabel}}</small></td><td><input type="number" name="quantity" value="{{entry.quantity}}" min="0" step="1" aria-label="Quantity for {{entry.name}}"></td><td><select name="stockMode" aria-label="Stock mode for {{entry.name}}">{{#each ../stockModes as |mode|}}<option value="{{mode}}" {{#if (eq entry.stockMode mode)}}selected{{/if}}>{{mode}}</option>{{/each}}</select><label class="row-field">Player stock<select name="stockVisibility" aria-label="Stock visibility for {{entry.name}}"><option value="exact" {{#if (eq entry.stockVisibility "exact")}}selected{{/if}}>Exact</option><option value="low" {{#if (eq entry.stockVisibility "low")}}selected{{/if}}>Low / available</option><option value="hidden" {{#if (eq entry.stockVisibility "hidden")}}selected{{/if}}>Hidden</option></select></label><label class="market-check row-check"><input type="checkbox" name="restockEnabled" {{#if entry.restock.enabled}}checked{{/if}}><span class="check-art" aria-hidden="true"></span><span><strong>Auto-restock</strong></span></label><label class="row-field">Restock target<input type="number" name="restockTarget" min="0" value="{{entry.restock.target}}"></label><label class="row-field">Restock anchor<input type="number" name="restockAnchorTime" value="{{entry.restock.anchorTime}}"></label><label class="row-field">Restock interval (seconds)<input type="number" name="restockIntervalSeconds" min="3600" value="{{entry.restock.intervalSeconds}}"></label><label class="row-field">Access mode<select name="accessMode"><option value="public" {{#if (eq entry.access.mode "public")}}selected{{/if}}>Public</option><option value="backroom" {{#if (eq entry.access.mode "backroom")}}selected{{/if}}>Backroom</option></select></label><label class="row-field">Access actor UUIDs (comma-separated)<input type="text" name="accessActorUuids" value="{{entry.accessActorUuidsText}}" aria-label="Access actor UUIDs for {{entry.name}}"></label><label class="row-field">Minimum reputation<input type="number" name="accessMinReputation" min="-100" max="100" value="{{entry.access.minReputation}}" aria-label="Minimum reputation for {{entry.name}}"></label></td><td><input type="checkbox" name="visible" {{#if entry.visible}}checked{{/if}} aria-label="Visible for {{entry.name}}"></td><td><button class="market-icon-button" type="button" data-action="save-entry" aria-label="Save {{entry.name}}">✓</button> <button class="market-icon-button remove-entry" type="button" data-action="delete-entry" data-entry-id="{{entry.id}}" aria-label="Remove {{entry.name}}">×</button><label class="row-field">Category<input type="text" name="category" value="{{entry.category}}" aria-label="Category for {{entry.name}}"></label><label class="row-field">Rarity<input type="text" name="rarity" value="{{entry.rarity}}" aria-label="Rarity for {{entry.name}}"></label></td></tr>
          {{/each}}
        </tbody></table></div>
        {{else}}
        <div class="empty-shelf"><span class="empty-glyph" aria-hidden="true">✧</span><h4>The shelves are bare</h4><p>Add an item from your world inventory to stock this shop.</p><button type="button" class="market-button market-button-outline" data-action="add-item-picker">Choose an item</button></div>
        {{/if}}
        <form class="table-generation" aria-label="Generate stock from a roll table"><p class="market-eyebrow">Roll table stock</p><label class="market-field"><span>Roll table</span><select name="rollTableUuid">{{#each drawTables as |table|}}<option value="{{table.uuid}}">{{table.name}}</option>{{/each}}</select></label><label class="market-field"><span>Draw count</span><input type="number" name="drawCount" min="1" max="20" value="1"></label><button type="button" class="market-button market-button-outline" data-action="generate-inventory" {{#unless isActiveGM}}disabled{{/unless}}>Generate inventory</button></form>
      </section>
      {{#if notice}}<p class="market-notice" role="status" aria-live="polite">{{notice}}</p>{{/if}}
      {{#if pickerOpen}}
      <section class="add-item-panel" aria-labelledby="add-item-heading">
         <div class="section-heading"><div><span class="section-number">04</span><div><p class="market-eyebrow">Stock the shelves</p><h3 id="add-item-heading">Add an item</h3></div></div></div>
        <div class="editor-fields">
          <label class="market-field field-wide"><span>Item UUID</span><div class="uuid-row"><input type="text" name="itemUuid" placeholder="Paste an Item UUID, or drop an item here..." autocomplete="off"><button type="button" class="market-button market-button-dark" data-action="add-item-uuid">Add</button></div></label>
        </div>
        <label class="market-search"><span class="visually-hidden">Search items</span><span aria-hidden="true">⌕</span><input type="search" name="pickerSearch" placeholder="Browse the world and compendiums..." autocomplete="off"></label>
        {{#if pickerItems.length}}
        <ul class="picker-list">{{#each pickerItems as |item|}}<li><button type="button" class="picker-item" data-action="add-item" data-uuid="{{item.uuid}}">{{#if item.img}}<img src="{{item.img}}" alt="">{{else}}<span class="item-thumb" aria-hidden="true">✦</span>{{/if}}<span>{{item.name}}</span></button></li>{{/each}}</ul>
        {{else}}<p class="market-muted">No items found in the world or compendiums.</p>{{/if}}
      </section>
      {{/if}}
      <div class="manager-footer-actions"><button type="button" class="market-button market-button-quiet" data-action="place-shop">Place shop</button><button type="button" class="market-button market-button-quiet" data-action="open-shop">View storefront</button></div>
      {{else}}
      <div class="manager-welcome"><span class="welcome-seal" aria-hidden="true">✧</span><p class="market-eyebrow">A world of possibility</p><h2>Set the scene<br>for a good trade.</h2><p>Select a shop to manage its details and stock, or create a new one in the selected location.</p>{{#if notice}}<p class="market-notice" role="status" aria-live="polite">{{notice}}</p>{{/if}}<button type="button" class="market-button market-button-dark" data-action="create-shop">Create a shop <span aria-hidden="true">→</span></button></div>
      {{/if}}
    </main>
  </div>
  <section class="editor-panel backup-panel" aria-labelledby="backup-heading">
    <div class="section-heading"><div><span class="section-number">09</span><div><p class="market-eyebrow">Portable world data</p><h2 id="backup-heading">GM backup &amp; restore</h2></div></div></div>
    <p class="market-muted backup-intro">Create a private JSON backup of locations and shops, or add records from a compatible backup.</p>
    <div class="backup-warning" role="note"><strong>Before you continue</strong><ul><li>Backups are private and include snapshots and item valuations. Store exported files securely.</li><li>Order, ledger, and reputation-event histories are not included.</li><li>Imports only add new locations and shops; they do not overwrite existing records. A partial import cannot be automatically rolled back.</li></ul></div>
    <div class="backup-actions" aria-label="Backup actions">
      <button type="button" class="market-button market-button-outline" data-action="export-backup" {{#unless isActiveGM}}disabled{{/unless}}>Export backup</button>
      <label class="market-field backup-file-field"><span>Choose backup JSON (up to 5 MB)</span><input type="file" name="backupFile" accept=".json,application/json" {{#unless isActiveGM}}disabled{{/unless}}></label>
      <button type="button" class="market-button market-button-quiet" data-action="preview-backup" {{#unless isActiveGM}}disabled{{/unless}}>Preview import</button>
      <label class="market-check backup-confirm"><input type="checkbox" name="confirmImport" {{#unless isActiveGM}}disabled{{/unless}}><span class="check-art" aria-hidden="true"></span><span><strong>I understand this adds records and may partially complete.</strong></span></label>
      <button type="button" class="market-button market-button-dark" data-action="import-backup" {{#unless isActiveGM}}disabled{{/unless}}>Import backup</button>
    </div>
    {{#if backupSummary}}<div class="backup-summary" role="status" aria-live="polite"><h3>Backup status</h3><p><strong>{{backupSummary.status}}</strong>{{#if backupSummary.error}} — {{backupSummary.error}}{{/if}}</p>{{#if (eq backupSummary.kind "export")}}<p>{{backupSummary.locations}} locations · {{backupSummary.shops}} shops in the exported backup.</p>{{else}}<p>Added {{backupSummary.createdLocations}} locations and {{backupSummary.createdShops}} shops.</p>{{#if backupSummary.partial}}<p class="backup-partial">The import partially completed; the listed records were added.</p>{{#if backupSummary.createdLocationIds.length}}<p>Locations: {{#each backupSummary.createdLocationIds as |id|}}{{#unless @first}}, {{/unless}}{{id}}{{/each}}</p>{{/if}}{{#if backupSummary.createdShopIds.length}}<p>Shops: {{#each backupSummary.createdShopIds as |id|}}{{#unless @first}}, {{/unless}}{{id}}{{/each}}</p>{{/if}}{{/if}}{{/if}}{{#if backupSummary.warnings.length}}<ul class="backup-warning-list">{{#each backupSummary.warnings as |warning|}}<li>{{warning}}</li>{{/each}}</ul>{{/if}}</div>{{/if}}
    {{#if backupPreview}}<div class="backup-summary" role="status" aria-live="polite"><h3>Import preview</h3><p>{{backupPreview.locations}} locations · {{backupPreview.shops}} shops will be added.</p>{{#if backupPreview.warnings.length}}<ul class="backup-warning-list">{{#each backupPreview.warnings as |warning|}}<li>{{warning}}</li>{{/each}}</ul>{{else}}<p>No preview warnings.</p>{{/if}}</div>{{/if}}
    {{#unless isActiveGM}}<p class="market-muted backup-gm-note">Only the active GM can export or import backups.</p>{{/unless}}
  </section>
</section>
