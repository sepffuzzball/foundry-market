<section class="market-app market-storefront theme-{{shop.theme}} density-{{shop.appearance.density}} motion-{{shop.appearance.animation}} typography-{{shop.appearance.typography}}" aria-label="{{shop.name}} storefront">
  <header class="storefront-header"><a class="storefront-brand" href="#" aria-label="Foundry Market home"><span class="market-sigil" aria-hidden="true">M</span><span>FOUNDRY <b>MARKET</b></span></a><button type="button" class="market-button market-button-quiet refresh-button" data-action="refresh"><span aria-hidden="true">↻</span> Refresh</button></header>
  {{#if shop}}
  <main class="storefront-content">
    <section class="shop-hero" aria-labelledby="store-title">
     <div class="hero-ornament" aria-hidden="true"><span></span><i>✧</i><span></span></div>
      <div class="owner-medallion" aria-hidden="true">{{#if (lookup merchants 0)}}{{#if (lookup (lookup merchants 0) "portrait")}}<img src="{{lookup (lookup merchants 0) "portrait"}}" alt="">{{else}}<span>✦</span>{{/if}}{{else}}{{#if shop.appearance.ownerPortrait}}<img src="{{shop.appearance.ownerPortrait}}" alt="">{{else}}<span>✦</span>{{/if}}{{/if}}</div>
      <p class="market-eyebrow">A place to find the unusual</p><h1 id="store-title">{{shop.name}}</h1>
      {{#if shop.owner}}<p class="shop-owner">Kept by <strong>{{shop.owner}}</strong></p>{{/if}}
      {{#if shop.description}}<p class="shop-description">{{shop.description}}</p>{{/if}}
      {{#if shop.appearance.welcomeMessage}}<p class="shop-welcome">{{shop.appearance.welcomeMessage}}</p>{{/if}}
      {{#if merchants.length}}<div class="merchant-social" aria-label="Shopkeepers">{{#each merchants as |merchant|}}<span class="merchant-chip">{{#if merchant.portrait}}<img src="{{merchant.portrait}}" alt="">{{else}}<span class="merchant-avatar-fallback" aria-hidden="true">✦</span>{{/if}}<span><strong>{{merchant.name}}</strong>{{#if merchant.role}}<small>{{merchant.role}}</small>{{/if}}</span></span>{{/each}}</div>{{/if}}
      {{#if (lookup merchants 0)}}<p class="merchant-greeting">{{#if (lookup (lookup merchants 0) "greeting")}}{{lookup (lookup merchants 0) "greeting"}}{{else}}Welcome. Take your time among the wares.{{/if}}</p>{{/if}}
      {{#if relationship}}<section class="relationship-panel" aria-label="Your relationship with this shop"><div class="relationship-copy"><p class="market-eyebrow">Standing with the shop</p><h2>{{relationship.title}}</h2><p>{{#if relationship.modifierText}}{{relationship.modifierText}}{{else}}Your standing shapes the prices offered here.{{/if}}</p><div class="relationship-meter"><meter min="-100" max="100" value="{{relationship.score}}" aria-label="Relationship score">{{relationship.score}} out of 100</meter><span class="relationship-score">{{relationship.score}} <small>/ 100</small></span></div></div><div class="relationship-splits"><span><small>Personal standing</small><strong>{{relationship.individual}}</strong></span><span><small>Party standing</small><strong>{{relationship.party}}</strong></span></div></section>{{/if}}
       {{#if shop.locationName}}<p class="shop-location">Currently trading in <strong>{{shop.locationName}}</strong></p>{{/if}}
       <span class="hero-status {{#if shop.open}}status-open{{else}}status-closed{{/if}}"><i aria-hidden="true"></i>{{#if shop.open}}Open for trade{{else}}Temporarily closed{{/if}}</span>
     </section>
     {{#if shop.marketEvents.length}}<section class="market-events" aria-label="Upcoming market events"><p class="market-eyebrow">At the market</p>{{#each shop.marketEvents as |event|}}<article class="market-event"><h2>{{event.title}}</h2>{{#if event.description}}<p>{{event.description}}</p>{{/if}}</article>{{/each}}</section>{{/if}}
    {{#if shop.open}}
    <section class="catalog" aria-labelledby="catalog-heading">
       <div class="catalog-toolbar"><div><p class="market-eyebrow">Carefully chosen goods</p><h2 id="catalog-heading">The collection</h2></div><div class="catalog-filters">{{#if categories.length}}<div class="category-tabs" role="group" aria-label="Filter by category">{{#each categories as |category|}}<button type="button" class="category-tab {{#if category.active}}is-active{{/if}}" data-action="filter-category" data-category="{{category.id}}" aria-pressed="{{#if category.active}}true{{else}}false{{/if}}">{{category.label}}</button>{{/each}}</div>{{/if}}<label class="sort-control"><span>Sort</span><select name="sort" data-action="sort-items"><option value="featured" {{#if (eq sort "featured")}}selected{{/if}}>Featured</option><option value="name" {{#if (eq sort "name")}}selected{{/if}}>Name</option><option value="price" {{#if (eq sort "price")}}selected{{/if}}>Price</option></select></label><label class="market-search"><span class="visually-hidden">Search items</span><span aria-hidden="true">⌕</span><input type="search" name="search" value="{{search}}" placeholder="Find something..." autocomplete="off"></label></div></div>
      {{#if inventory.length}}
      <div class="product-grid">{{#each inventory as |entry|}}
           <article class="product-card" data-action="inspect" data-entry-id="{{entry.id}}" tabindex="0"><div class="product-art">{{#if entry.img}}<img src="{{entry.img}}" alt="">{{else}}<span class="portrait-fallback" aria-hidden="true"><i>✦</i></span>{{/if}}<span class="stock-tag product-stock">{{#if (eq entry.stockMode "unlimited")}}Always available{{else}}{{entry.stockLabel}}{{/if}}</span></div><div class="product-info"><p class="product-category">{{entry.category}} <span>{{entry.rarity}}</span></p><h3>{{entry.name}}</h3>{{#if entry.publicDescription}}<p class="product-description">{{entry.publicDescription}}</p>{{/if}}<div class="product-buy-row"><p class="product-price"><strong>{{entry.price}}</strong><span>{{../currencyLabel}}</span>{{#if entry.basePrice}}{{#unless (eq entry.basePrice entry.price)}}<del>{{entry.basePrice}}</del>{{/unless}}{{/if}}</p><button type="button" class="buy-button" data-action="buy" data-entry-id="{{entry.id}}" {{#if (or (not entry.available) (not ../hasGM) ../pending (eq entry.canBuy false))}}disabled{{/if}}>Buy <span aria-hidden="true">→</span></button><button type="button" class="buy-button" data-action="add-to-cart" data-entry-id="{{entry.id}}" aria-label="Add {{entry.name}} to cart" {{#if (or (not entry.available) (not ../hasGM) ../pending (eq entry.canBuy false))}}disabled{{/if}}>Add to cart</button>{{#if (and (not entry.available) entry.canPreorder)}}<button type="button" class="buy-button" data-action="place-preorder" data-entry-id="{{entry.id}}" {{#if (or (not ../hasGM) ../pending)}}disabled{{/if}}>Place preorder</button>{{/if}}{{#if entry.canAttemptTheft}}<button type="button" class="buy-button" data-action="attempt-theft" data-entry-id="{{entry.id}}" {{#if (or (not ../hasGM) ../pending)}}disabled{{/if}}>Submit theft attempt</button>{{/if}}</div></div></article>
      {{/each}}</div>
      {{else}}
      <div class="storefront-empty"><span aria-hidden="true">✧</span><h3>Nothing on the shelves just yet</h3><p>Check back later. New goods may arrive soon.</p></div>
     {{/if}}
     {{#if selectedEntry}}
     <section class="entry-detail" aria-labelledby="entry-detail-title" tabindex="-1">
       <button type="button" class="detail-close" data-action="close-detail" aria-label="Close item details">×</button>
       <div class="detail-art">{{#if selectedEntry.img}}<img src="{{selectedEntry.img}}" alt="">{{else}}<span aria-hidden="true">✦</span>{{/if}}</div>
         <div class="detail-copy"><p class="product-category">{{selectedEntry.category}} <span>{{selectedEntry.rarity}}</span></p><h2 id="entry-detail-title">{{selectedEntry.name}}</h2><p class="detail-description">{{selectedEntry.publicDescription}}</p><p class="detail-stock">{{#if (eq selectedEntry.stockMode "unlimited")}}Always available{{else}}{{selectedEntry.stockLabel}}{{/if}}</p><div class="product-buy-row"><p class="product-price"><strong>{{selectedEntry.price}}</strong><span>{{currencyLabel}}</span>{{#if selectedEntry.basePrice}}{{#unless (eq selectedEntry.basePrice selectedEntry.price)}}<del>{{selectedEntry.basePrice}}</del>{{/unless}}{{/if}}</p><button type="button" class="buy-button" data-action="buy" data-entry-id="{{selectedEntry.id}}" aria-disabled="{{#if (or (eq selectedEntry.canBuy false) pending (not hasGM) (not selectedEntry.available))}}true{{else}}false{{/if}}" {{#if (or (eq selectedEntry.canBuy false) pending (not hasGM) (not selectedEntry.available))}}disabled{{/if}}>Buy <span aria-hidden="true">→</span></button></div>{{#if selectedEntry.priceLines.length}}<ul class="price-breakdown" aria-label="Price details">{{#each selectedEntry.priceLines as |line|}}<li><span>{{line.label}}</span><strong>{{line.value}}</strong></li>{{/each}}</ul>{{/if}}</div>
     </section>
     {{/if}}
    </section>
    {{else}}
     <div class="storefront-notice" role="status"><span aria-hidden="true">◷</span><div><h2>The shop is closed</h2><p>{{#if (eq shop.closedReason "outside-hours")}}The shop is outside its scheduled hours. Please return during its next opening.{{else if (eq shop.closedReason "not-arrived")}}The shop has not arrived at this location yet.{{else if (eq shop.closedReason "manually-closed")}}The shopkeeper has closed the doors for now. Please check back another time.{{else}}This storefront is not taking orders right now. Please check back another time.{{/if}}</p></div></div>
    {{/if}}
      {{#if actors.length}}
      <section class="trade-tools" aria-label="Additional trade options">
        <div class="trade-tool-heading"><p class="market-eyebrow">Beyond the shelves</p><h2>Services &amp; special offers</h2></div>
        {{#if shop.services.length}}<div class="trade-card-grid">{{#each shop.services as |service|}}<article class="trade-card"><div><h3>{{service.name}}</h3>{{#if service.description}}<p>{{service.description}}</p>{{/if}}<strong>{{service.price}} {{../currencyLabel}}</strong></div><button type="button" class="buy-button" data-action="book-service" data-service-id="{{service.id}}" {{#if (or ../pending (not ../hasGM) (not ../selectedActorId) (not ../shop.open))}}disabled{{/if}}>Request service</button></article>{{/each}}</div>{{/if}}
        {{#if shop.specials.length}}<div class="trade-card-grid">{{#each shop.specials as |special|}}<article class="trade-card"><div><h3>{{special.title}}</h3>{{#if special.description}}<p>{{special.description}}</p>{{/if}}<strong>{{special.price}} {{../currencyLabel}}</strong></div><button type="button" class="buy-button" data-action="add-special-to-cart" data-special-id="{{special.id}}" {{#if (or ../pending (not ../hasGM) (not ../selectedActorId) (not ../shop.open))}}disabled{{/if}}>Add special</button></article>{{/each}}</div>{{/if}}
        {{#if shop.preordersEnabled}}<p class="trade-note">Preorders are available for eligible items.</p>{{/if}}{{#if shop.theftEnabled}}<p class="trade-note">Theft attempts are adjudicated by the GM; no outcome is automatic.</p>{{/if}}
      </section>
      {{#if cartLines.length}}<section class="cart-panel" aria-labelledby="cart-heading"><div class="trade-tool-heading"><p class="market-eyebrow">Your basket</p><h2 id="cart-heading">Cart</h2></div><ul class="cart-lines">{{#each cartLines as |line|}}<li><span>{{line.name}} × {{line.quantity}}</span><strong>{{line.total}} {{../currencyLabel}}</strong><button type="button" class="buy-button" data-action="remove-from-cart" data-entry-id="{{line.entryId}}" data-special-id="{{line.specialId}}" aria-label="Remove {{line.name}} from cart" {{#if ../pending}}disabled{{/if}}>Remove</button></li>{{/each}}</ul><p class="cart-total">Total <strong>{{cartTotal}} {{currencyLabel}}</strong></p>{{#if cartEstimate}}<p class="cart-estimate">Estimated total - choose a character to get exact pricing.</p>{{/if}}<button type="button" class="buy-button" data-action="checkout-cart" {{#if (or pending (not hasGM) (not selectedActorId) (not shop.open))}}disabled{{/if}}>Checkout cart</button></section>{{/if}}
      {{#if sellItems.length}}<section class="trade-forms" aria-label="Sell or barter items"><label class="market-field"><span>Sell an item</span><select name="sellItemId"><option value="">Choose an item</option>{{#each sellItems as |item|}}<option value="{{item.id}}">{{item.name}}</option>{{/each}}</select></label><button type="button" class="buy-button" data-action="sell-item" {{#if (or pending (not hasGM) (not selectedActorId) (not shop.open))}}disabled{{/if}}>Sell item</button><label class="market-field"><span>Optional barter item</span><select name="barterItemId"><option value="">No barter item</option>{{#each barterItems as |item|}}<option value="{{item.id}}">{{item.name}}</option>{{/each}}</select></label></section>{{else if sellEmpty}}<section class="trade-forms" aria-label="Sell or barter items"><p class="market-muted">Ask the GM to value an item before selling or bartering it.</p></section>{{/if}}
      {{#if (and shop.preordersEnabled preorderEntries.length)}}<section class="trade-forms" aria-label="Preorder an item"><label class="market-field"><span>Preorder item</span><select name="preorderEntryId"><option value="">Choose an item</option>{{#each preorderEntries as |entry|}}<option value="{{entry.id}}">{{entry.name}}</option>{{/each}}</select></label><button type="button" class="buy-button" data-action="place-preorder" {{#if (or pending (not hasGM) (not selectedActorId) (not shop.open))}}disabled{{/if}}>Place preorder</button></section>{{/if}}
      {{#if (and shop.theftEnabled theftEntries.length)}}<section class="trade-forms" aria-label="Theft attempt"><label class="market-field"><span>Attempt to steal</span><select name="theftEntryId"><option value="">Choose an item</option>{{#each theftEntries as |entry|}}<option value="{{entry.id}}">{{entry.name}}</option>{{/each}}</select></label><button type="button" class="buy-button" data-action="attempt-theft" {{#if (or pending (not hasGM) (not selectedActorId) (not shop.open))}}disabled{{/if}}>Submit attempt for GM review</button></section>{{/if}}
       <label class="purchase-actor"><span>Shopping as</span><select id="market-actor" name="actorId"><option value="">Choose a character</option>{{#each actors as |actor|}}<option value="{{actor.id}}" {{#if (eq ../selectedActorId actor.id)}}selected{{/if}}>{{actor.name}}</option>{{/each}}</select></label>
       <label class="quantity-label" for="market-quantity">Qty</label><input id="market-quantity" type="number" name="quantity" min="1" value="{{quantity}}" inputmode="numeric" aria-label="Purchase quantity">
    {{#if feedback}}<p class="market-feedback" role="status" aria-live="polite">{{feedback}}</p>{{/if}}
     {{#if pending}}<p class="market-pending" role="status" aria-live="polite"><span class="pending-mark" aria-hidden="true"></span> Processing your request...</p>{{/if}}
     <button type="button" class="sound-toggle" data-action="toggle-sound" aria-pressed="{{#if soundEnabled}}true{{else}}false{{/if}}">{{#if soundEnabled}}Sound on{{else}}Sound off{{/if}}</button>
      {{/if}}
  </main>
  {{else}}
  <main class="storefront-missing"><span class="welcome-seal" aria-hidden="true">✧</span><p class="market-eyebrow">No destination selected</p><h1>This market has<br>no open door.</h1><p>Select a shop to browse its wares.</p>{{#if loading}}<p class="market-muted">Loading the storefront...</p>{{else}}{{#unless hasGM}}<p class="market-muted">A Game Master may need to open a shop first.</p>{{/unless}}<button type="button" class="market-button market-button-dark" data-action="refresh">Try again <span aria-hidden="true">↻</span></button>{{/if}}</main>
  {{/if}}
  <footer class="storefront-footer"><span>FOUNDRY MARKET</span><span>Good finds travel far.</span></footer>
</section>
